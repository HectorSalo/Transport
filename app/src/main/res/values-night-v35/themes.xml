<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Transport" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="colorPrimary">@color/blue_base_ligth</item>
        <item name="colorPrimaryVariant">@color/blue_base_dark</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/yellow_base_ligth</item>
        <item name="colorSecondaryVariant">@color/yellow_base_ligth</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

</resources>